<?xml version="1.0"?>
<package format="2">
  <name>abb_crb15000_5_95_moveit_config</name>
  <version>0.0.0</version>
  <description>
    <p>
      MoveIt package for the ABB CRB 15000‑5/0.95 collaborative robot.
    </p>
    <p>
      This package was generated by using the IRB‑1200 MoveIt configuration as
      a template and adapting it for the CRB 15000 robot.  It contains all
      necessary configuration files (joint limits, kinematics, planning
      parameters, etc.) and an RViz layout to work with the MoveIt motion
      planning framework.
    </p>
  </description>
  <author email="example@todo.invalid">Generated Port</author>
  <maintainer email="example@todo.invalid">Generated Port</maintainer>
  <license>BSD</license>

  <url type="website">http://wiki.ros.org/abb_crb15000_5_95_moveit_config</url>
  <url type="repository">https://github.com/ros-industrial/abb</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Depend on the support package providing the robot description and meshes -->
  <exec_depend>abb_crb15000_support</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <!-- <architecture_independent /> -->
  </export>
</package>